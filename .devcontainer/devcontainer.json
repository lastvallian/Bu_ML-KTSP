{
    "name": "FastAPI & React (Bu_ML-KTSP)",
    "image": "://microsoft.com",
    
    // Automation for dependence
    "postCreateCommand": "cd python/KTSP_Meta && pip install -r requirements.txt && cd ../../KTSP_front && npm install",
    
    // Open to 2 terminals for FastAPI 和 React
    "postAttachCommand": "code --terminal-directory=python/KTSP_Meta -e 'uvicorn main:app --reload' && code --terminal-directory=KTSP_front -e 'npm start'",
    
    // Automated for two ports
    "forwardPorts": [3000, 8000],
    
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "dbaeumer.vscode-eslint"
            ]
        }
    }
}

