{
    "name": "FastAPI & React (Bu_ML-KTSP)",
    // 1. Use a standard Ubuntu base image instead of Alpine
    "image": "://microsoft.com",
    
    // 2. Install both Python and Node.js runtimes concurrently via features
    "features": {
        "ghcr.io/devcontainers/features/python:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        }
    },
    
    // 3. Install backend pip and frontend npm dependencies after container creation
    "postCreateCommand": "cd python/KTSP_Meta && pip install -r requirements.txt && cd ../../KTSP_front && npm install",
    
    // 4. Launch both servers in the background simultaneously to prevent blocking
    "postAttachCommand": "(cd python/KTSP_Meta && nohup uvicorn main:app --host 0.0.0.0 --port 8000 > fastapi.log 2>&1 &) && (cd KTSP_front && nohup npm start > react.log 2>&1 &)",
    
    // 5. Forward the React (3000) and FastAPI (8000) ports to public URLs
    "forwardPorts": [3000, 8000],
    
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "dbaeumer.vscode-eslint"
            ]
        }
    }
}
